# magic environment configuration
# Copy this file to .env and fill in your values. Never commit .env.

# ============================================================================
# Storage
# ============================================================================

# Root directory for sessions, repos, KB, spill files
# Default: ./.magic (relative to where the server runs)
MAGIC_DATA_DIR=./.magic

# Whether to cache cloned repos under ${MAGIC_DATA_DIR}/repos/<hash>/
# Set false to use a tmp dir per session (no persistence between sessions)
MAGIC_KEEP_REPO=true

# Persistence backend: jsonl | sqlite
# jsonl = append-only files per session (simpler, fine for individuals)
# sqlite = FTS5 indexed search, better for large session counts
MAGIC_PERSISTENCE=jsonl

# Maximum repo size in MB to accept via cloneOrAttach
# Repos larger than this are rejected with a clear error
MAGIC_MAX_REPO_MB=500

# ============================================================================
# Security
# ============================================================================

# Permission preset: read-only | workspace-write | danger-full-access
# read-only: bash refused outside repo, file edits outside repo blocked
# workspace-write: bash + edits allowed inside repo
# danger-full-access: bash allowed everywhere (DANGEROUS)
MAGIC_PERMISSION_PRESET=workspace-write

# Network mode for tool-mediated egress (httpRequest, MCP, repo security)
# open: any URL allowed
# localhost-only: only http://localhost, http://127.0.0.1, http://[::1]
# Note: model provider calls (Bedrock etc.) are always allowed regardless
MAGIC_NETWORK_MODE=open

# Bearer token for REST API auth (Authorization: Bearer <token>)
# Required when the server is reachable from outside localhost
# Generate one with: openssl rand -hex 32
MAGIC_API_TOKEN=

# Comma-separated list of allowed origins for CORS
# Default: http://localhost:5173 (Vite dev server)
MAGIC_ALLOWED_ORIGINS=http://localhost:5173

# ============================================================================
# Sandbox resource limits
# ============================================================================

# Maximum memory in MB per sandbox subprocess
MAGIC_SANDBOX_MAX_MEMORY_MB=2048

# Maximum CPU cores per sandbox subprocess (fractional allowed: 0.5, 1.0, 2.0)
MAGIC_SANDBOX_MAX_CPU=2.0

# Maximum disk in MB for sandbox writes
MAGIC_SANDBOX_MAX_DISK_MB=5120

# ============================================================================
# Server
# ============================================================================

# Port for the Fastify server
PORT=4317

# Bind address: 127.0.0.1 (default, safe) or 0.0.0.0 (requires MAGIC_API_TOKEN)
# Default: 127.0.0.1 — magic refuses to expose the API to every
# interface unless this flag is explicitly set. Combine with
# MAGIC_API_TOKEN when exposing beyond loopback.
# MAGIC_BIND_ALL_INTERFACES=false

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ============================================================================
# Model provider — set one of the following blocks
# ============================================================================

# --- Option 1: Local model (Ollama / llama.cpp / any OpenAI-compatible) ---
# MAGIC_MODEL_PROVIDER=ollama
# MAGIC_MODEL_BASE_URL=http://localhost:11434/v1
# MAGIC_MODEL_NAME=qwen2.5-coder:14b
# MAGIC_MODEL_API_KEY=

# --- Option 2: Amazon Bedrock ---
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=your_bedrock_bearer_token
# MAGIC_BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# --- Option 3: Anthropic direct ---
# ANTHROPIC_API_KEY=your_anthropic_key

# --- Option 4: OpenAI ---
# OPENAI_API_KEY=your_openai_key

# --- Option 5: Google ---
# GOOGLE_API_KEY=your_google_key

# --- Option 6: MiniMax (OpenAI-compatible) ---
# MINIMAX_API_KEY=your_minimax_key
# MINIMAX_BASE_URL=https://api.minimax.chat/v1
# MINIMAX_MODEL=MiniMax-M3

# ============================================================================
# Provider fallback (optional)
# ============================================================================

# Comma-separated fallback chain if primary provider fails N consecutive times
# Example: openai,anthropic means try OpenAI first, fall back to Anthropic
# Default: empty (no fallback)
# MAGIC_PROVIDER_FALLBACK=

# Maximum consecutive failures before swapping to fallback provider
# Default: 3
# MAGIC_PROVIDER_FALLBACK_THRESHOLD=3

# ============================================================================
# Cost cap
# ============================================================================

# Maximum USD per session before halting
# Default: 0 (no cap)
# MAGIC_COST_CAP_USD=0

# ============================================================================
# MCP docs server (optional)
# ============================================================================

# Whether to enable the Strands docs MCP server
# Requires uv (https://github.com/astral-sh/uv) installed
# Set false to skip; the agent will still work but without on-demand Strands docs
# MAGIC_MCP_DOCS_ENABLED=true

# Custom command for the MCP server (defaults to uvx strands-agents-mcp-server)
# MAGIC_MCP_DOCS_COMMAND=uvx
# MAGIC_MCP_DOCS_ARGS=strands-agents-mcp-server

# ============================================================================
# Playwright (optional, used by agent to reproduce UI bugs)
# ============================================================================

# Comma-separated domains the Playwright tool may navigate to
# Default: localhost,127.0.0.1
# MAGIC_PLAYWRIGHT_DOMAINS=localhost,127.0.0.1
