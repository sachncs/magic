{
  "name": "magic",
  "version": "0.1.0",
  "private": true,
  "description": "Strands Agents-powered web app for true agentic software engineering on any repo",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,ui -c blue,green \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:server": "tsx watch apps/web/src/server/server.ts",
    "dev:ui": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts && tsc -p apps/web/tsconfig.node.json",
    "start": "node dist/apps/web/server/server.js",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "typecheck": "tsc -p packages/shared && tsc -p packages/storage && tsc -p packages/tools && tsc -p packages/agent-graph && tsc -p apps/web",
    "lint": "gts lint",
    "format": "gts fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e:browser": "playwright test --config apps/web/playwright.config.ts",
    "test:a11y": "playwright test --config apps/web/playwright.config.ts --grep @a11y",
    "test:eval": "tsx tests/eval/runner.ts",
    "commit": "cz",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "site:preview": "npm --prefix site run preview"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog",
      "maxHeaderLength": 100,
      "maxLineWidth": 100,
      "defaultType": "feat",
      "types": [
        { "value": "feat",     "name": "feat:     a new feature" },
        { "value": "fix",      "name": "fix:      a bug fix" },
        { "value": "docs",     "name": "docs:     documentation only changes" },
        { "value": "style",    "name": "style:    formatting, no code change" },
        { "value": "refactor", "name": "refactor: code change that neither fixes a bug nor adds a feature" },
        { "value": "perf",     "name": "perf:     performance improvement" },
        { "value": "test",     "name": "test:     add or correct tests" },
        { "value": "build",    "name": "build:    build system or external dependencies" },
        { "value": "ci",       "name": "ci:       CI configuration or scripts" },
        { "value": "chore",    "name": "chore:    other changes that don't modify src or test files" },
        { "value": "revert",   "name": "revert:   reverts a previous commit" }
      ]
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/node": "^20.11.0",
    "commitizen": "^4.3.2",
    "concurrently": "^8.2.2",
    "cz-conventional-changelog": "^3.3.0",
    "gts": "^5.3.1",
    "tsx": "^4.7.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/magic.git"
  },
  "homepage": "https://github.com/your-org/magic#readme",
  "bugs": {
    "url": "https://github.com/your-org/magic/issues"
  },
  "keywords": [
    "agentic",
    "ai-agents",
    "strands",
    "software-engineering",
    "code-review",
    "refactoring"
  ],
  "license": "MIT"
}
