---
import Logo from './ui/Logo.astro';
---

<section class="relative pt-36 pb-24 md:pt-44 md:pb-32">
  <!-- atmospheric orbs -->
  <div aria-hidden="true" class="glow-orb left-[-10%] top-[-5%] h-[420px] w-[420px] bg-amber/40"></div>
  <div aria-hidden="true" class="glow-orb right-[-15%] top-[20%] h-[520px] w-[520px] bg-accent-violet/25"></div>

  <div class="container-page relative">
    <div class="mx-auto max-w-4xl text-center">
      <!-- Eyebrow -->
      <div class="reveal flex items-center justify-center gap-2.5 text-2xs font-medium uppercase tracking-[0.22em] text-white/60">
        <span class="eyebrow-dot"></span>
        <span>v1 · Agent graph for software engineering</span>
      </div>

      <!-- Headline -->
      <h1 class="reveal mt-8 font-display text-display-lg font-semibold tracking-tightest text-balance text-white">
        Software engineering,
        <br class="hidden sm:block" />
        <span class="text-gradient-amber">actually engineered.</span>
      </h1>

      <!-- Subhead -->
      <p class="reveal mx-auto mt-7 max-w-2xl text-balance text-lg leading-[1.55] text-white/65 md:text-xl">
        magic is an explicit agent graph that <span class="text-white">plans, edits, verifies and ships</span> code on any
        repository. Every change must clear <span class="font-mono text-white/85">typecheck + lint + test + build</span>
        before it can become a PR.
      </p>

      <!-- CTAs -->
      <div class="reveal mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
        <a href="#get-started" class="btn-primary group">
          <svg viewBox="0 0 16 16" class="h-4 w-4 fill-current opacity-90" aria-hidden="true">
            <path d="M5.52.43A6 6 0 0 1 13.5 6c0 1.49-.55 2.85-1.45 3.9l2.16 2.16a.75.75 0 0 1-1.06 1.06l-2.16-2.16A6 6 0 1 1 5.52.43Zm.6 2.65a4.5 4.5 0 1 0 4.46 5.86L7.96 6.86a.75.75 0 0 1-1.06-1.06l2.62-2.62A4.5 4.5 0 0 0 6.12 3.08Z"/>
          </svg>
          Get started
          <span class="font-mono text-[11px] text-ink-700/80">npm i</span>
        </a>
        <a href="#workflow" class="btn-ghost">
          See the agent graph
          <svg viewBox="0 0 16 16" class="h-3 w-3 fill-current" aria-hidden="true">
            <path d="M3 3.75A.75.75 0 0 1 3.75 3h8.5a.75.75 0 0 1 0 1.5h-8.5A.75.75 0 0 1 3 3.75Zm.75 4.5a.75.75 0 0 1 .75-.75h8.5a.75.75 0 0 1 0 1.5h-8.5a.75.75 0 0 1-.75-.75Zm0 4.5a.75.75 0 0 1 .75-.75h5.5a.75.75 0 0 1 0 1.5h-5.5a.75.75 0 0 1-.75-.75Z"/>
          </svg>
        </a>
      </div>

      <!-- Stat strip -->
      <dl class="reveal mx-auto mt-10 flex max-w-2xl items-center justify-center gap-6 sm:gap-10">
        <div class="text-center">
          <dt class="text-2xs uppercase tracking-[0.18em] text-white/40">Verification gates</dt>
          <dd class="mt-1 font-display text-2xl font-semibold text-white">4</dd>
        </div>
        <div class="stat-divider"></div>
        <div class="text-center">
          <dt class="text-2xs uppercase tracking-[0.18em] text-white/40">Built-in agents</dt>
          <dd class="mt-1 font-display text-2xl font-semibold text-white">10</dd>
        </div>
        <div class="stat-divider"></div>
        <div class="text-center">
          <dt class="text-2xs uppercase tracking-[0.18em] text-white/40">Model providers</dt>
          <dd class="mt-1 font-display text-2xl font-semibold text-white">6+</dd>
        </div>
        <div class="stat-divider"></div>
        <div class="text-center">
          <dt class="text-2xs uppercase tracking-[0.18em] text-white/40">Approval gates</dt>
          <dd class="mt-1 font-display text-2xl font-semibold text-white">3</dd>
        </div>
      </dl>
    </div>

    <!-- Hero mock — animated agent graph -->
    <div class="reveal relative mx-auto mt-16 max-w-5xl md:mt-20">
      <div class="panel">
        <!-- macOS-style chrome -->
        <div class="flex items-center justify-between border-b border-white/[0.06] px-5 py-3">
          <div class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
          </div>
          <div class="flex items-center gap-2 rounded-md border border-white/5 bg-white/[0.03] px-3 py-1 text-[11px] font-mono text-white/50">
            <Logo size={12} />
            magic · session · af-91c4
          </div>
          <div class="flex items-center gap-2 text-[11px] text-white/40">
            <span class="inline-flex items-center gap-1.5">
              <span class="relative flex h-1.5 w-1.5">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400/60"></span>
                <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
              </span>
              live
            </span>
          </div>
        </div>

        <!-- Body: graph + log -->
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px]">
          <!-- Graph -->
          <div class="relative aspect-[4/3] overflow-hidden border-b border-white/[0.06] p-6 lg:border-b-0 lg:border-r">
            <svg viewBox="0 0 480 360" class="h-full w-full" role="img" aria-label="Agent graph topology">
              <defs>
                <linearGradient id="edge" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0%" stop-color="rgba(241,224,90,0)" />
                  <stop offset="50%" stop-color="rgba(241,224,90,0.9)" />
                  <stop offset="100%" stop-color="rgba(241,224,90,0)" />
                </linearGradient>
                <filter id="glow" x="-30%" y="-30%" width="160%" height="160%">
                  <feGaussianBlur stdDeviation="4" result="b" />
                  <feMerge>
                    <feMergeNode in="b" />
                    <feMergeNode in="SourceGraphic" />
                  </feMerge>
                </filter>
              </defs>

              <!-- grid -->
              <g opacity="0.08">
                {Array.from({ length: 12 }).map((_, i) => (
                  <line x1="0" x2="480" y1={i * 30} y2={i * 30} stroke="white" stroke-width="0.5" />
                ))}
                {Array.from({ length: 17 }).map((_, i) => (
                  <line x1={i * 30} x2={i * 30} y1="0" y2="360" stroke="white" stroke-width="0.5" />
                ))}
              </g>

              <!-- Edges -->
              <g class="text-white/40" fill="none" stroke-width="1.2">
                <!-- indexer → planner -->
                <path d="M 240 60 L 240 120" class="edge-anim" />
                <!-- indexer → harness -->
                <path d="M 240 60 L 110 120" class="edge-anim" />
                <!-- indexer → security -->
                <path d="M 240 60 L 370 120" class="edge-anim" />
                <!-- planner/harness/security → router -->
                <path d="M 110 160 L 200 200" class="edge-anim" />
                <path d="M 240 160 L 240 200" class="edge-anim" />
                <path d="M 370 160 L 280 200" class="edge-anim" />
                <!-- router → swarm -->
                <path d="M 240 220 L 240 270" class="edge-anim" />
                <!-- swarm → verifier -->
                <path d="M 240 295 L 240 330" class="edge-anim" />
              </g>

              <!-- Nodes -->
              <g font-family="ui-monospace, monospace" font-size="9" fill="rgba(255,255,255,0.7)">
                <!-- indexer -->
                <g transform="translate(210,40)">
                  <rect width="60" height="40" rx="10" fill="#11121e" stroke="rgba(241,224,90,0.7)" />
                  <text x="30" y="17" text-anchor="middle" fill="#f1e05a" font-weight="600">indexer</text>
                  <text x="30" y="30" text-anchor="middle" fill="rgba(255,255,255,0.5)">runs first</text>
                </g>

                <!-- parallel trio -->
                <g transform="translate(80,120)">
                  <rect width="60" height="40" rx="10" fill="#11121e" stroke="rgba(255,255,255,0.18)" />
                  <text x="30" y="17" text-anchor="middle" fill="#fff">harness</text>
                  <text x="30" y="30" text-anchor="middle" fill="rgba(255,255,255,0.45)">detector</text>
                </g>
                <g transform="translate(210,120)">
                  <rect width="60" height="40" rx="10" fill="#11121e" stroke="rgba(255,255,255,0.18)" />
                  <text x="30" y="17" text-anchor="middle" fill="#fff">planner</text>
                  <text x="30" y="30" text-anchor="middle" fill="rgba(255,255,255,0.45)">3–8 steps</text>
                </g>
                <g transform="translate(340,120)">
                  <rect width="60" height="40" rx="10" fill="#11121e" stroke="rgba(255,255,255,0.18)" />
                  <text x="30" y="17" text-anchor="middle" fill="#fff">security</text>
                  <text x="30" y="30" text-anchor="middle" fill="rgba(255,255,255,0.45)">auditor</text>
                </g>

                <!-- router -->
                <g transform="translate(210,200)">
                  <rect width="60" height="40" rx="10" fill="#11121e" stroke="rgba(124,92,255,0.7)" />
                  <text x="30" y="17" text-anchor="middle" fill="#cdc1ff" font-weight="600">router</text>
                  <text x="30" y="30" text-anchor="middle" fill="rgba(255,255,255,0.5)">classifies</text>
                </g>

                <!-- swarm -->
                <g transform="translate(190,260)">
                  <rect width="100" height="50" rx="12" fill="#11121e" stroke="rgba(95,227,161,0.55)" />
                  <text x="50" y="20" text-anchor="middle" fill="#cdf5e0" font-weight="600">coder swarm</text>
                  <text x="50" y="34" text-anchor="middle" fill="rgba(255,255,255,0.5)">explain · refactor · ship</text>
                </g>

                <!-- verifier -->
                <g transform="translate(210,330)">
                  <rect width="60" height="22" rx="8" fill="#11121e" stroke="rgba(241,224,90,0.7)" />
                  <text x="30" y="15" text-anchor="middle" fill="#f1e05a" font-weight="600" font-size="9">verifier</text>
                </g>
              </g>

              <!-- traveling token -->
              <circle r="3" fill="#f1e05a" filter="url(#glow)">
                <animateMotion
                  dur="5s"
                  repeatCount="indefinite"
                  path="M 240 60 L 240 120 L 240 160 L 240 200 L 240 260 L 240 330 L 240 350"
                />
              </circle>
            </svg>
          </div>

          <!-- Log -->
          <div class="font-mono text-[11px] leading-[1.6] text-white/65 p-5">
            <div class="flex items-center gap-2 text-white/45">
              <span class="rounded-full bg-amber/20 px-2 py-0.5 text-[10px] text-amber">RUN</span>
              <span>session af-91c4 · task #14</span>
            </div>
            <ul class="mt-3 space-y-2">
              <li class="flex items-start gap-2">
                <span class="mt-[5px] h-1 w-1 shrink-0 rounded-full bg-emerald-400"></span>
                <span><span class="text-emerald-300">✓</span> indexer · manifest emitted</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-[5px] h-1 w-1 shrink-0 rounded-full bg-emerald-400"></span>
                <span><span class="text-emerald-300">✓</span> planner · 5 steps</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-[5px] h-1 w-1 shrink-0 rounded-full bg-emerald-400"></span>
                <span><span class="text-emerald-300">✓</span> security · 0 findings</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-[5px] h-1 w-1 shrink-0 rounded-full bg-white/30"></span>
                <span>router → <span class="text-white">coder</span> swarm</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-[5px] h-1 w-1 shrink-0 rounded-full bg-amber animate-pulse-soft"></span>
                <span>verifier · running <span class="text-amber">typecheck</span></span>
              </li>
            </ul>

            <div class="mt-5 rounded-lg border border-white/[0.06] bg-white/[0.02] p-3">
              <div class="text-[10px] uppercase tracking-[0.16em] text-white/40">Cost so far</div>
              <div class="mt-1 flex items-baseline gap-1">
                <span class="font-display text-lg text-white">$0.014</span>
                <span class="text-white/40">/ 1.2k tok</span>
              </div>
              <div class="mt-3 h-1 w-full overflow-hidden rounded-full bg-white/[0.06]">
                <div class="h-full w-2/3 rounded-full bg-gradient-to-r from-amber to-amber-200"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- bottom glow -->
      <div aria-hidden="true" class="pointer-events-none absolute -bottom-24 left-1/2 -z-10 h-72 w-[80%] -translate-x-1/2 rounded-full bg-amber/15 blur-3xl"></div>
    </div>
  </div>
</section>

<style>
  .edge-anim {
    stroke: rgba(255, 255, 255, 0.25);
    stroke-dasharray: 4 4;
    animation: dash 1.4s linear infinite;
  }
  @keyframes dash {
    to {
      stroke-dashoffset: -16;
    }
  }
</style>