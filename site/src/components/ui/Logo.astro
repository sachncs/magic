---
const { class: className = '', size = 28 } = Astro.props as { class?: string; size?: number };
---
<svg
  class={`inline-block ${className}`}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="logoGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#fff7c2" />
      <stop offset="55%" stop-color="#f1e05a" />
      <stop offset="100%" stop-color="#c9b13a" />
    </linearGradient>
  </defs>
  <rect x="0" y="0" width="32" height="32" rx="8" fill="#0d0e17" />
  <rect x="0" y="0" width="32" height="32" rx="8" fill="url(#logoGrad)" fill-opacity="0.18" />
  <path
    d="M8 22 L8 12 L13 19 L18 12 L18 22"
    fill="none"
    stroke="url(#logoGrad)"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <circle cx="24" cy="10" r="2.4" fill="url(#logoGrad)" />
  <path
    d="M22.5 9.5 L24 7.5 L25.5 9.5 M24 7.5 L24 12.5"
    stroke="#f1e05a"
    stroke-width="1.2"
    stroke-linecap="round"
    opacity="0.85"
  />
</svg>