---
import Logo from './ui/Logo.astro';

const cols = [
  {
    title: 'Product',
    links: [
      { href: '#capabilities', label: 'Capabilities' },
      { href: '#workflow', label: 'How it works' },
      { href: '#stack', label: 'Stack' },
      { href: '#get-started', label: 'Get started' },
    ],
  },
  {
    title: 'Documentation',
    links: [
      { href: 'https://github.com/sachncs/magic/blob/main/docs/architecture.md', label: 'Architecture' },
      { href: 'https://github.com/sachncs/magic/blob/main/docs/agentic_overview.md', label: 'Agentic overview' },
      { href: 'https://github.com/sachncs/magic/blob/main/docs/agents.md', label: 'Agents reference' },
      { href: 'https://github.com/sachncs/magic/blob/main/docs/providers.md', label: 'Model providers' },
    ],
  },
  {
    title: 'Decisions',
    links: [
      { href: 'https://github.com/sachncs/magic/tree/main/packages/agent-graph/docs/adr', label: 'ADR index' },
      { href: 'https://github.com/sachncs/magic/blob/main/packages/agent-graph/docs/adr/0001-topology.md', label: 'ADR-0001 · Topology' },
      { href: 'https://github.com/sachncs/magic/blob/main/packages/agent-graph/docs/adr/0003-sandbox.md', label: 'ADR-0003 · Sandbox' },
      { href: 'https://github.com/sachncs/magic/blob/main/CHANGELOG.md', label: 'Changelog' },
    ],
  },
  {
    title: 'Project',
    links: [
      { href: 'https://github.com/sachncs/magic', label: 'Source on GitHub' },
      { href: 'https://github.com/sachncs/magic/blob/main/LICENSE', label: 'License · MIT' },
      { href: 'https://github.com/sachncs/magic/blob/main/CONTRIBUTING.md', label: 'Contributing' },
      { href: 'https://github.com/sachncs/magic/blob/main/SECURITY.md', label: 'Security' },
    ],
  },
];
---

<footer class="relative border-t border-white/[0.06] bg-ink-950">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/20 to-transparent"></div>

  <div class="container-wide pt-20 pb-12">
    <div class="grid grid-cols-2 gap-10 md:grid-cols-6 md:gap-12">
      <div class="col-span-2">
        <a href={(import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`)} class="inline-flex items-center gap-2.5">
          <Logo size={28} />
          <span class="font-display text-lg font-semibold text-white">magic</span>
        </a>
        <p class="mt-5 max-w-sm text-[14px] leading-relaxed text-white/55">
          True agentic software engineering on any repository. MIT-licensed. Best-effort personal project.
        </p>
        <div class="mt-6 flex items-center gap-3">
          <a
            href="https://github.com/sachncs/magic"
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 bg-white/[0.02] text-white/70 transition hover:border-white/20 hover:bg-white/[0.05] hover:text-white"
            aria-label="GitHub"
          >
            <svg viewBox="0 0 16 16" class="h-4 w-4 fill-current" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          </a>
          <a
            href="https://github.com/sachncs/magic/issues"
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 bg-white/[0.02] text-white/70 transition hover:border-white/20 hover:bg-white/[0.05] hover:text-white"
            aria-label="Issues"
          >
            <svg viewBox="0 0 16 16" class="h-4 w-4 fill-current" aria-hidden="true"><path d="M8 9.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"/><path d="M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0ZM1.5 8a6.5 6.5 0 1 0 13 0 6.5 6.5 0 0 0-13 0Z"/></svg>
          </a>
          <a
            href="https://github.com/sachncs/magic/blob/main/LICENSE"
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 bg-white/[0.02] text-white/70 transition hover:border-white/20 hover:bg-white/[0.05] hover:text-white"
            aria-label="License"
          >
            <svg viewBox="0 0 16 16" class="h-4 w-4 fill-current" aria-hidden="true"><path d="M8.75 1.75a.75.75 0 0 0-1.5 0v.514a4.25 4.25 0 0 0-3.13 1.59.75.75 0 1 0 1.16.95A2.75 2.75 0 0 1 7.25 3.5v6.69A3.03 3.03 0 0 0 5.5 13a3 3 0 0 0 2.25-1.03.75.75 0 1 0-1.16-.95A1.5 1.5 0 1 1 5.5 9.5a.75.75 0 0 0 0-1.5A3.04 3.04 0 0 0 4 8.81V3.5a2.75 2.75 0 0 1 2.25-1.25.75.75 0 0 0 0-1.5Z"/><path d="M11 4a.75.75 0 0 1 .75-.75A3.5 3.5 0 0 1 15 6.75v2.5a3.5 3.5 0 0 1-3.25 3.5.75.75 0 0 1 0-1.5A2 2 0 0 0 13.5 9.25v-2.5A2 2 0 0 0 11.75 5 .75.75 0 0 1 11 4Z"/></svg>
          </a>
        </div>
      </div>

      {cols.map((col) => (
        <div>
          <h3 class="text-2xs uppercase tracking-[0.18em] text-white/40">{col.title}</h3>
          <ul class="mt-5 space-y-3">
            {col.links.map((l) => (
              <li>
                <a href={l.href} class="link-elegant text-[13.5px]">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-16 flex flex-col items-start justify-between gap-4 border-t border-white/[0.06] pt-8 md:flex-row md:items-center">
      <div class="flex items-center gap-3 font-mono text-[11.5px] text-white/40">
        <span class="inline-flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 shadow-[0_0_8px_2px_rgba(52,211,153,0.5)]"></span>
          main
        </span>
        <span class="text-white/20">·</span>
        <span>CI passing</span>
        <span class="text-white/20">·</span>
        <span>MIT license</span>
      </div>
      <div class="font-mono text-[11.5px] text-white/35">
        © {new Date().getFullYear()} sachncs · Built with Astro + Tailwind
      </div>
    </div>
  </div>
</footer>