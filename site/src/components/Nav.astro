---
import Logo from './ui/Logo.astro';

const nav = [
  { href: '#capabilities', label: 'Capabilities' },
  { href: '#workflow', label: 'How it works' },
  { href: '#stack', label: 'Stack' },
  { href: '#docs', label: 'Docs' },
];
---

<header class="fixed inset-x-0 top-0 z-50">
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-ink-950/85 to-transparent backdrop-blur-md"></div>
  <div class="container-wide">
    <div class="mt-4 flex h-14 items-center justify-between rounded-full border border-white/[0.07] bg-ink-950/55 px-4 shadow-[0_1px_0_rgba(255,255,255,0.04)_inset,0_24px_60px_-20px_rgba(0,0,0,0.5)] backdrop-blur-xl md:mt-6 md:h-16 md:px-6">
      <a href={(import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`)} class="group flex items-center gap-2.5">
        <Logo size={26} class="transition-transform duration-500 group-hover:rotate-[8deg]" />
        <span class="text-[15px] font-semibold tracking-tight text-white">magic</span>
        <span class="ml-1 hidden rounded-full border border-amber/30 bg-amber/10 px-2 py-[2px] text-[10px] font-medium uppercase tracking-[0.18em] text-amber md:inline-flex">
          v1 preview
        </span>
      </a>

      <nav class="hidden items-center gap-1 md:flex">
        {nav.map((item) => (
          <a
            href={item.href}
            class="rounded-full px-3 py-1.5 text-[13.5px] text-white/65 transition-colors hover:bg-white/5 hover:text-white"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <a
          href="https://github.com/sachncs/magic"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-1.5 text-[13px] text-white/85 transition hover:border-white/20 hover:bg-white/[0.06] hover:text-white sm:inline-flex"
          aria-label="magic on GitHub"
        >
          <svg viewBox="0 0 16 16" class="h-3.5 w-3.5 fill-current" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
          </svg>
          Star on GitHub
        </a>
        <a
          href="#get-started"
          class="btn-primary !px-4 !py-2 text-[13px]"
        >
          Get started
          <svg viewBox="0 0 16 16" class="h-3 w-3 fill-current transition-transform group-hover:translate-x-0.5" aria-hidden="true">
            <path d="M5.22 4.22a.75.75 0 0 1 1.06 0L11.19 9.13a.75.75 0 0 1 0 1.06L6.28 14.78a.75.75 0 0 1-1.06-1.06L9.44 10.5H1.75a.75.75 0 0 1 0-1.5h7.69L5.22 5.28a.75.75 0 0 1 0-1.06Z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>