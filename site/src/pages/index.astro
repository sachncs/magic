---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import ValueProps from '../components/ValueProps.astro';
import Capabilities from '../components/Capabilities.astro';
import Workflow from '../components/Workflow.astro';
import Stack from '../components/Stack.astro';
import CodePreview from '../components/CodePreview.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="magic — true agentic software engineering"
  description="magic is an explicit agent graph that plans, edits, verifies, and ships code on any repository — with real verification gates at every step."
>
  <Nav />
  <main>
    <Hero />
    <ValueProps />
    <Capabilities />
    <Workflow />
    <Stack />
    <CodePreview />
    <CTA />
  </main>
  <Footer />
</Base>